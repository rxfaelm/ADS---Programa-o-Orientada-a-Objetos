class Piramide {
    double base;
    double altura;

    Piramide(double base, double altura) {
        this.base = base;
        this.altura = altura;
    }

    public double calcularVolume() {
        return (1.0 / 3.0) * base * altura;
    }
}

public class Main {
    public static void main(String[] args) {
        Piramide piramide = new Piramide(6, 9);

        System.out.println("Volume: " + piramide.calcularVolume());
    }
}
